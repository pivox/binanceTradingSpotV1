ENVIRONMENT=dev
DATABASE_URL=postgresql+psycopg://user:pass@localhost:5433/tradebot
TEMPORAL_ADDRESS=localhost:7233
BINANCE_API_KEY=
BINANCE_API_SECRET=
EXECUTION_MODE=dry_run
SHARD_COUNT=8
BINANCE_REST_URL=https://api.binance.com
USDC_PAIRS_LIMIT=200
API_HOST=0.0.0.0
API_PORT=8000
DAEMON_PID_FILE=/tmp/ws_candle_daemon.pid
DAEMON_COMMAND=python -m tradebot.apps.ws_candle_daemon
DAEMON_STOP_TIMEOUT_S=1.0
CHART_MAX_LIMIT=1000
RBAC_ENABLED=false
RBAC_ADMIN_USERS=
RBAC_OPERATOR_USERS=
RBAC_STATUS_ROLES=admin,operator
RBAC_USER_HEADER=X-User
